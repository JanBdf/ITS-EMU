#!/bin/sh
# Attaches the ITS-Board emulator's ST-LINK, exported over USB/IP on this
# computer (127.0.0.1, bus id 1-1), with the kernel's vhci-hcd driver.
# its-emu-gui runs it through pkexec (polkit action its-emu.usbip-attach).
set -eu
port="${1:-3240}"
case "$port" in
  '' | *[!0-9]*) echo "usage: $0 [PORT]" >&2; exit 2 ;;
esac
if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
  echo "port out of range: $port" >&2
  exit 2
fi
modprobe vhci-hcd 2>/dev/null || true
exec /usr/bin/usbip --tcp-port "$port" attach -r 127.0.0.1 -b 1-1
