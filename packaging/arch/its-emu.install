load_vhci() {
  # USB/IP host driver for the emulated ST-LINK: loaded at boot from now on
  # (modules-load.d), here for the running system. A kernel update without a
  # restart since has removed the running kernel's modules.
  modprobe vhci-hcd 2>/dev/null && return
  if [ ! -d "/usr/lib/modules/$(uname -r)" ]; then
    cat <<MSG
==> WARNING: the running kernel ($(uname -r)) was updated without a restart
    since, its modules are gone. Restart the computer before using the
    emulator's USB ST-LINK (the vhci-hcd module cannot be loaded until then).
MSG
  else
    echo "==> WARNING: cannot load the vhci-hcd kernel module (USB ST-LINK of the emulator)"
  fi
}

post_install() {
  load_vhci
  cat <<'MSG'
==> ITS-Board emulator: its-emu (command line), its-emu-gui (application menu).
==> The VS Code extension "gdbtarget: Run Without Debugging" is built in to
    the code package. Remove a copy installed earlier from the .vsix with
      code --uninstall-extension its-emu.gdbtarget-nodebug
    Other VS Code builds: /usr/share/its-emu/gdbtarget-nodebug.vsix
==> The GUI plugs in the board's ST-LINK (toolbar: USB ST-LINK), usable by
    pyOCD/OpenOCD and as /dev/ttyACM*.
MSG
}

post_upgrade() {
  load_vhci
}
