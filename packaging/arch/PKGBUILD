# Arch package of the ITS-Board emulator, built from the local checkout.
# Not run directly: packaging/arch/build.sh copies it into target/, sets
# pkgver from git and points ITS_EMU_ROOT at the checkout.

pkgname=its-emu
pkgver=0
pkgrel=1
pkgdesc='Emulator for the HAW Hamburg ITS-Board (STM32F429 + ITS carrier board + TFT) with a USB ST-LINK for pyOCD'
arch=(x86_64)
license=(MIT)
# The GUI loads the window system, GL/Vulkan and D-Bus (file dialog via the
# XDG portal) at run time, so ldd does not show them.
depends=(glibc gcc-libs dbus fontconfig libglvnd vulkan-icd-loader wayland
         libx11 libxcb libxcursor libxi libxkbcommon libxkbcommon-x11 hicolor-icon-theme
         # the board's ST-LINK on USB/IP: usbip attach through a polkit helper
         usbip polkit)
makedepends=(cargo cmake clang git zip)
optdepends=('arm-none-eabi-gdb: debugging the firmware through the GDB server'
            'code: Run Without Debugging (Ctrl+F5) for the emulator launch configuration'
            'xdg-desktop-portal: file dialog of the GUI')
install=its-emu.install
# no -debug split package; makepkg's LTO flags are not meant for Unicorn's C build
options=(!debug !lto)

build() {
  cd "$ITS_EMU_ROOT"
  # own target directory: makepkg's CFLAGS/RUSTFLAGS differ from those of
  # normal builds and would rebuild Unicorn every time
  CARGO_TARGET_DIR="$ITS_EMU_ROOT/target/pkg-cargo" \
    cargo build --release --locked -p its-emu -p its-emu-gui
  tools/vscode-nodebug/package.sh >/dev/null
}

package() {
  cd "$ITS_EMU_ROOT"
  local bin="$ITS_EMU_ROOT/target/pkg-cargo/release"
  install -Dm755 "$bin/its-emu" "$bin/its-emu-gui" -t "$pkgdir/usr/bin/"
  install -Dm644 packaging/arch/its-emu-gui.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 packaging/arch/its-emu-gui.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"

  # The ST-LINK on USB/IP: vhci-hcd at boot, a helper that polkit lets the
  # user at the computer run to attach the probe (from 127.0.0.1 only), and
  # access for the logged-in user to the probe and its virtual COM port
  local arch=packaging/arch
  install -Dm755 $arch/usbip-attach "$pkgdir/usr/lib/its-emu/usbip-attach"
  install -Dm644 $arch/its-emu.policy "$pkgdir/usr/share/polkit-1/actions/its-emu.usbip-attach.policy"
  install -Dm644 $arch/vhci-hcd.conf "$pkgdir/usr/lib/modules-load.d/its-emu.conf"
  install -Dm644 $arch/70-its-emu-stlink.rules -t "$pkgdir/usr/lib/udev/rules.d/"

  # VS Code extension: built in to Code - OSS (Arch's code package), so
  # pacman owns it and removes it with the package; the .vsix for other
  # VS Code builds
  local ext=tools/vscode-nodebug
  install -Dm644 $ext/package.json $ext/extension.js $ext/README.md \
    -t "$pkgdir/usr/lib/code/extensions/its-emu.gdbtarget-nodebug/"
  install -Dm644 $ext/gdbtarget-nodebug.vsix -t "$pkgdir/usr/share/$pkgname/"
}
