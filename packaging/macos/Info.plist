<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- packaging/macos/build.sh fills in @VERSION@ and @BUILD@ -->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>ITS-Board Emulator</string>
  <key>CFBundleDisplayName</key>
  <string>ITS-Board Emulator</string>
  <key>CFBundleIdentifier</key>
  <string>de.haw-hamburg.its-emu</string>
  <key>CFBundleExecutable</key>
  <string>its-emu-gui</string>
  <key>CFBundleIconFile</key>
  <string>its-emu-gui</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@BUILD@</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.developer-tools</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!-- the emulator keeps real time while its window is hidden (App Nap
       would throttle it, and with it the GDB server) -->
  <key>NSAppSleepDisabled</key>
  <true/>
</dict>
</plist>
